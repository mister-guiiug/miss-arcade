# Engendré par `pwa-env sync` depuis config/env.manifest.json.
# App : miss-arcade
# Ne pas éditer à la main : modifier le manifeste, puis relancer sync --write.

# Choix de backend (local / supabase / …)
VITE_BACKEND=

# Clé projet PostHog — seul interrupteur de la mesure
# Repli : absent : aucune mesure
VITE_POSTHOG_KEY=

# Adresse pour exercer les droits (acces, rectification, opposition)
VITE_PRIVACY_CONTACT=

# Responsable du traitement affiche dans la notice de confidentialite
VITE_PRIVACY_CONTROLLER=

# Fondement juridique des rapports d erreur (mention d exploitant)
VITE_PRIVACY_ERROR_BASIS=

# Duree de conservation des donnees detaillees, en mois (PostHog)
VITE_PRIVACY_RETENTION_MONTHS=

# DSN Sentry
# Repli : absent : no-op
VITE_SENTRY_DSN=

# Clé anon publique
# Repli : absent : backend local
VITE_SUPABASE_ANON_KEY=

# URL Supabase (mode distant)
# Repli : absent : backend local
VITE_SUPABASE_URL=
