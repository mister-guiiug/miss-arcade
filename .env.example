# Engendré par `pwa-env sync` depuis config/env.manifest.json.
# App : miss-arcade
# Ne pas éditer à la main : modifier le manifeste, puis relancer sync --write.

# Choix de backend (local / supabase / …)
VITE_BACKEND=

# Clé projet PostHog — seul interrupteur de la mesure
# Repli : absent : aucune mesure
VITE_POSTHOG_KEY=

# DSN Sentry
# Repli : absent : no-op
VITE_SENTRY_DSN=

# Clé anon publique
# Repli : absent : backend local
VITE_SUPABASE_ANON_KEY=

# URL Supabase (mode distant)
# Repli : absent : backend local
VITE_SUPABASE_URL=
